# Acme Web App — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://acme_user:password@localhost:5432/acme_db

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-in-production-use-32-char-min
SESSION_SECRET=another-secret-for-sessions

# External APIs
ACME_API_KEY=your-acme-api-key-here
STRIPE_SECRET_KEY=sk_test_your_stripe_key
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# Monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
DATADOG_API_KEY=your_datadog_api_key

# Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=acme-assets-dev
AWS_REGION=us-east-1

# Feature Flags
FEATURE_FLAG_NEW_DASHBOARD=false
FEATURE_FLAG_BETA_API=false
